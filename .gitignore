# Local archive and machine-specific state
/.workspace/
/.env
/.env.*
!/.env.example
/configs/upstream-files.txt
/configs/upstream-archives.json

# Upstream source is restored from repo-manifest.json. Only local guides ship.
/repos/**
!/repos/*/
!/repos/*/AGENTS.md

# Raw inputs live under Source; track only guides and folder placeholders.
/Source/**
!/Source/**/
!/Source/**/AGENTS.md
!/Source/**/.gitkeep

# Generated media and caches
/output/**
!/output/**/
!/output/**/.gitkeep
/temp/**
!/temp/**/
!/temp/**/.gitkeep
/projects/*/working/**
!/projects/*/working/**/
!/projects/*/working/**/.gitkeep
/projects/*/previews/**
!/projects/*/previews/**/
!/projects/*/previews/**/.gitkeep
/projects/*/public/**
!/projects/*/public/**/
!/projects/*/public/**/.gitkeep
/projects/*/node_modules/
/projects/*/.env
/projects/*/.env.*
/projects/*/dist/
/projects/*/out/

# Tooling
__pycache__/
*.py[cod]
node_modules/
.DS_Store
Thumbs.db

# Media belongs to local storage, including derived examples in docs.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.m4v
*.mxf
*.mts
*.m2ts
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.aiff
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.avif
*.heic
*.tif
*.tiff
*.bmp
*.ttf
*.otf
*.woff
*.woff2
*.glb
*.gltf
*.fbx
*.blend
*.lottie
*.zip
*.7z
*.exe
*.dll
*.so
*.dylib
.env
.env.*
!.env.example
